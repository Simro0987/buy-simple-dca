# Secrets for the api component. Put this file (filled in) at /appdata/secrets.env of the
# "api" component (Flux volume browser), then restart "api". Only this container reads it.
# Never commit it. All values are optional - features without a key are simply disabled.
TELEGRAM_BOT_TOKEN=
# AI (Agent chat, news summaries). Any OpenAI-compatible endpoint (OpenRouter, OpenAI, Groq, local LLM).
# The browser never sees this key.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# optional: force one model for all AI calls. Default model names are OpenRouter style
# (e.g. google/gemini-2.5-flash); set this when AI_BASE_URL is not OpenRouter (e.g. gpt-4o-mini).
AI_MODEL=
CRYPTOPANIC_API_KEY=
ETHERSCAN_API_KEY=
MOBULA_API_KEY=
# optional: own Solana RPC for the read-only data proxy (e.g. https://mainnet.helius-rpc.com/?api-key=...)
SOLANA_RPC_URL=
# optional: Coinglass API key (funding rates); without it Binance funding is used
COINGLASS_API_KEY=
