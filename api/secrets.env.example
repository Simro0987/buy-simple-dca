# Secrets for the api component. Put this file (filled in) at /appdata/secrets.env of the
# "api" component (Flux volume browser), then restart "api". Only this container reads it.
# Never commit it. All values are optional - features without a key are simply disabled.
TELEGRAM_BOT_TOKEN=
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, local LLM ...). Replaces LOVABLE_API_KEY.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# optional: force one model for all AI calls (otherwise the original model names are sent,
# e.g. google/gemini-2.5-flash - OpenRouter understands them)
AI_MODEL=
CRYPTOPANIC_API_KEY=
ETHERSCAN_API_KEY=
MOBULA_API_KEY=
