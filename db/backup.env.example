# Backup config for the db component. Put this file (filled in) into the db volume root:
#   Flux: component "db" -> volume /var/lib/postgresql/data -> backup.env   (then restart "db")
# It stays private to the db container (chmod 600, owned by postgres). Never commit it.
#
# Storj: https://storj.io -> Access Keys -> "S3 Credentials", restricted to ONE bucket with
# permissions Write + List + Delete (Read is not needed for backups).
S3_ENDPOINT=https://gateway.storjshare.io
S3_BUCKET=buy-simple-dca-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# age PUBLIC key(s) (age1...); comma separated. The PRIVATE key stays offline with you.
BACKUP_AGE_RECIPIENTS=
# optional
#S3_PREFIX=buy-simple-dca/
#BACKUP_KEEP_DAYS=30
#BACKUP_KEEP_MIN=7
