# 1. Režim systému (PAPER je povinný predvolený režim — fail-closed)
# Povolené hodnoty: PAPER | SHADOW | TESTNET | LIMITED_LIVE | PAUSE
VITE_SYSTEM_EXECUTION_MODE="PAPER"
TREASURY_LIVE="0"
TREASURY_INSTANCE_ID="safebtc-srv1"

# 2. Voliteľný Cloud Sync / Telemetria (Supabase public anon key — bez tajomstiev)
VITE_SUPABASE_PROJECT_ID="ctykeosgiekmdhgdcvgc"
VITE_SUPABASE_URL="https://ctykeosgiekmdhgdcvgc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# 3. Verejné RPC Endpointy (Read-Only / Simulácia — žiadne privátne kľúče)
VITE_RPC_ETHEREUM="https://eth.llamarpc.com"
VITE_RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
VITE_RPC_BASE="https://mainnet.base.org"
VITE_RPC_OPTIMISM="https://mainnet.optimism.io"
VITE_RPC_SOLANA="https://api.mainnet-beta.solana.com"
VITE_PYTH_HERMES_URL="https://hermes.pyth.network"

# 4. Verejné Read-Only adresy 4 oddelených Vaultov (len verejné 0x / base58 adresy)
VITE_COLD_TREASURY_SAFE_ADDRESS=""
VITE_STRATEGY_SAFE_ADDRESS=""
