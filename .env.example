# ============================================================================
# buy-simple-dca - PUBLIC build/runtime settings of the web app (example)
# ============================================================================
# Everything here is visible to every visitor of the site. NEVER put a seed phrase,
# private key, API key or password here. Server secrets belong only in the api
# container: /appdata/secrets.env (see api/secrets.env.example).
# On Flux all of these are set at RUNTIME (environmentParameters of "web"); no rebuild needed.
# ============================================================================

# Own API (Flux component "api"), proxied by nginx under /api on the same origin.
VITE_API_URL="/api"

# Optional public URL of the app (Flux default domain or your own), used for the
# Safe App manifest and links. Empty = the current origin.
VITE_PUBLIC_APP_URL=""

# PAPER is the fail-closed default. Allowed: PAPER | SHADOW | TESTNET | LIMITED_LIVE | PAUSE
VITE_SYSTEM_EXECUTION_MODE="PAPER"

# Optional: free WalletConnect project id (https://cloud.reown.com). Without it
# "Open in Safe{Wallet}" and "watch address" still work; the WalletConnect button is disabled.
VITE_WALLETCONNECT_PROJECT_ID=""

# Optional: default Safe chain (arbitrum | base | ethereum | optimism)
VITE_DEFAULT_SAFE_CHAIN=""

# Optional: agent-runner status URL (default: /agent-api/status via nginx)
VITE_AGENT_STATUS_URL=""
