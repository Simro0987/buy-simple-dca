# Public client env (safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Exchange API — SERVER ONLY (never expose to frontend)
# Enable live trading only when keys are configured on the deployment host
EXCHANGE_LIVE_ENABLED=false
EXCHANGE_PROVIDER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: use testnet or regional endpoint
# BINANCE_API_BASE_URL=https://testnet.binance.vision

# Optional integrations
# CRYPTOPANIC_API_KEY=
# OPENAI_API_KEY=
# COINMARKETCAP_API_KEY=
